{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window (D047): only its own commands.",
  "windows": ["settings"],
  "permissions": [
    "allow-settings-get",
    "allow-hotkey-recording",
    "allow-hotkey-check",
    "allow-hotkey-apply",
    "allow-settings-set-double-ctrl-c",
    "allow-settings-set-record-history"
  ]
}
