# Normalize line endings: store LF in the repository on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
*.db binary
*.sqlite binary
*.zip binary
